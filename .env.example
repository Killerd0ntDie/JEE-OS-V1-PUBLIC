# Frontend Firebase Config (public client credentials)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Backend Firebase Admin SDK (private credentials)
# In production, provide either GOOGLE_APPLICATION_CREDENTIALS path or inline JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# AI Provider API Keys
GEMINI_API_KEY="your-gemini-api-key"
# Optional fallback pool keys:
# GEMINI_API_KEY_1="key-1"
# GEMINI_API_KEY_2="key-2"
# GROQ_API_KEY="your-groq-key"

# Server & Network Configuration
PORT=3000
HOST="0.0.0.0"
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Development escape hatch (only used if NODE_ENV !== 'production' and adminAuth not initialized)
DEV_AUTH_TOKEN="your-local-dev-token"
